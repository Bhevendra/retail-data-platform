{
  "table": "retaildataplatform.silver.sales",
  "layer": "SILVER",
  "checks": [
    {"name": "sales_not_empty", "type": "min_row_count", "threshold": 1, "severity": "error", "on_failure": "fail"},
    {"name": "customer_id_not_null", "type": "not_null", "column": "customer_id", "severity": "error", "on_failure": "fail"},
    {"name": "order_date_not_null", "type": "not_null", "column": "order_date", "severity": "error", "on_failure": "fail"},
    {"name": "quantity_non_negative", "type": "range", "column": "quantity", "min": 0, "severity": "warn", "on_failure": "warn"},
    {"name": "total_price_non_negative", "type": "range", "column": "total_price", "min": 0, "severity": "warn", "on_failure": "warn"}
  ]
}
